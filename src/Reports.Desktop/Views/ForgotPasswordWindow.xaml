<ui:FluentWindow x:Class="Reports.Desktop.Views.ForgotPasswordWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Reports.Desktop.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:ForgotPasswordViewModel}"
                 Title="Відновлення пароля"
                 Width="400" Height="380"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Відновлення пароля" />

        <Border Grid.Row="1" Padding="32,20">
            <StackPanel VerticalAlignment="Center" MaxWidth="300">

                <ui:TextBlock Text="Крок 1 — підтвердити через Google"
                              FontTypography="BodyStrong" Margin="0,0,0,8" />

                <ui:Button Content="Увійти через Google"
                           Appearance="Secondary"
                           HorizontalAlignment="Stretch"
                           Icon="{ui:SymbolIcon Globe24}"
                           Command="{Binding VerifyViaGoogleCommand}"
                           IsEnabled="{Binding GoogleVerified,
                                       Converter={StaticResource InverseBool}}"
                           Margin="0,0,0,16" />

                <ui:TextBlock Text="Крок 2 — новий пароль"
                              FontTypography="BodyStrong" Margin="0,0,0,8" />

                <PasswordBox x:Name="NewPasswordBox"
                             IsEnabled="{Binding GoogleVerified}"
                             Margin="0,0,0,4" />

                <PasswordBox x:Name="ConfirmPasswordBox"
                             IsEnabled="{Binding GoogleVerified}"
                             Margin="0,0,0,12" />

                <ui:Button x:Name="ResetBtn"
                           Content="Змінити пароль"
                           Appearance="Primary"
                           HorizontalAlignment="Stretch"
                           IsEnabled="{Binding GoogleVerified}"
                           Click="ResetBtn_Click"
                           Margin="0,0,0,12" />

                <ui:TextBlock Text="{Binding Status}"
                              FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"
                              Visibility="{Binding Status,
                                           Converter={StaticResource EmptyToCollapsed}}" />

            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
